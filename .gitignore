.gradle/
build/
out/
run/
.idea/
*.iml
__pycache__/
*.py[cod]
*.log

# Local audit inputs and downloaded archives do not belong in Git.
*.zip

# Vendored binary prerequisites are reconstructed from RESOURCE_IMPORT_MANIFEST.tsv by
# scripts/download_dependencies.py (CI does this on every run). They are not committed:
# the TaCZ jar alone is ~58 MB per release line. Synced from the 26.3 branch, which
# already carried this rule.
libs/*.jar

# CI log pushback is committed by the workflows themselves on arena/** branches; a local
# build must not leak its own logs into a commit.
build-reports/
