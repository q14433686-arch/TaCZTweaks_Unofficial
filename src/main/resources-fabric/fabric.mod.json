{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Addon for the Timeless and Classics Zero (TaCZ) mod, adapted for TaCZ_Refabricated_Unofficial 26.2.",
  "authors": [
    "MUKSC"
  ],
  "contact": {
    "repo": "https://github.com/q14433686-arch/TaCZTweaks_Unofficial",
    "issues": "https://github.com/q14433686-arch/TaCZTweaks_Unofficial/issues",
    "homepage": "https://github.com/q14433686-arch/TaCZTweaks_Unofficial"
  },
  "license": "GNU General Public License v3.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "me.muksc.tacztweaks.fabric.TaCZTweaksMod"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "me.muksc.tacztweaks.fabric.TaCZTweaksModClient"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "me.muksc.tacztweaks.fabric.compat.ModMenuCompat"
      }
    ]
  },
  "accessWidener": "${mod_id}.accesswidener",
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "yet_another_config_lib_v3": ">=${yacl_version}",
    "tacz": ">=${tacz_version_min}",
    "minecraft": "${minecraft_version}"
  }
}